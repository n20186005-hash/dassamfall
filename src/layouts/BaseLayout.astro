---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE_NAME, INDEPENDENT_DISCLAIMER } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  robots?: string;
  canonicalPath?: string;
  jsonLd?: Array<Record<string, unknown>>;
}

const { title, description, image = '/images/dassam-falls-02.jpg', jsonLd = [], robots = 'index,follow', canonicalPath } = Astro.props;
const canonical = Astro.site ? new URL(canonicalPath || Astro.url.pathname, Astro.site).toString() : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).toString() : image;
const siteRoot = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';

// Site-wide identity graph. The publisher is explicitly an independent third party,
// never the government or the attraction management.
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteRoot}#website`,
      url: `${siteRoot}/`,
      name: SITE_NAME,
      inLanguage: 'hi',
      publisher: { '@id': `${siteRoot}#publisher` },
    },
    {
      '@type': 'Organization',
      '@id': `${siteRoot}#publisher`,
      name: SITE_NAME,
      url: `${siteRoot}/`,
      description: INDEPENDENT_DISCLAIMER,
    },
  ],
};
const allJsonLd = [siteJsonLd, ...jsonLd];
---

<!doctype html>
<html lang="hi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0f1714" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Dassam Falls reference photo, Kingshuk Mondal, CC BY 4.0 via Wikimedia Commons; resized, not current conditions" />
    <meta property="og:locale" content="hi_IN" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Dassam Falls reference photo, Kingshuk Mondal, CC BY 4.0 via Wikimedia Commons; resized, not current conditions" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {allJsonLd.map((entry) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body>
    <slot />
    <CookieConsent />
  </body>
</html>
