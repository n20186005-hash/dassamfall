---
const gaId = 'G-HXM22WWPKP';
---

<div class="cookie-banner" id="cookie-banner" hidden>
  <div class="cookie-panel">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <h2 class="m-0 text-lg font-semibold">कुकी व विश्लेषण अनुमति</h2>
        <p class="mt-2 text-sm leading-7 text-white/75">
          यह साइट केवल आपकी सहमति मिलने पर Google Analytics 4 ({gaId}) लोड करती है।
          आपकी पसंद इसी ब्राउज़र के localStorage में सुरक्षित रखी जाती है।
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <button class="button-secondary" type="button" data-cookie-action="reject">केवल आवश्यक</button>
        <button class="button-primary" type="button" data-cookie-action="accept">स्वीकार करें</button>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ gaId }}>
  (() => {
    const storageKey = 'dassam-falls-cookie-consent';
    const banner = document.getElementById('cookie-banner');
    if (!banner) return;

    const injectGa = () => {
      if (window.__dassamGaLoaded) return;
      window.__dassamGaLoaded = true;

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag(){ window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId, { anonymize_ip: true });
    };

    const read = () => { try { return localStorage.getItem(storageKey); } catch { return null; } };
    const save = (value) => { try { localStorage.setItem(storageKey, value); } catch {} };
    const disable = () => {
      window['ga-disable-' + gaId] = true;
      if (window.gtag) window.gtag('consent', 'update', { analytics_storage: 'denied' });
      document.cookie.split(';').forEach((entry) => {
        const name = entry.trim().split('=')[0];
        if (!/^_ga(?:_|$)/.test(name)) return;
        for (const domain of ['', location.hostname, '.' + location.hostname.replace(/^www\./, '')]) {
          document.cookie = name + '=; Max-Age=0; path=/' + (domain ? '; domain=' + domain : '');
        }
      });
    };
    const stored = read();
    if (stored === 'accepted') injectGa();
    else if (stored !== 'rejected') banner.hidden = false;
    document.querySelectorAll('[data-cookie-settings]').forEach((button) => button.addEventListener('click', () => {
      banner.hidden = false;
      banner.querySelector('button')?.focus();
    }));
    banner.querySelectorAll('[data-cookie-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const accept = button.getAttribute('data-cookie-action') === 'accept';
        save(accept ? 'accepted' : 'rejected');
        if (accept) {
          window['ga-disable-' + gaId] = false;
          if (window.gtag) window.gtag('consent', 'update', { analytics_storage: 'granted' });
          injectGa();
        } else disable();
        banner.hidden = true;
      });
    });
    window.addEventListener('storage', (event) => {
      if (event.key === storageKey && event.newValue !== 'accepted') { disable(); banner.hidden = event.newValue === 'rejected'; }
    });
  })();
</script>
